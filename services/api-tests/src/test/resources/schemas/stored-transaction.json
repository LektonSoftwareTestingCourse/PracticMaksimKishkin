{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "status": {
      "type": "string",
      "enum": ["stored"]
    }
  },
  "additionalProperties": true
}
