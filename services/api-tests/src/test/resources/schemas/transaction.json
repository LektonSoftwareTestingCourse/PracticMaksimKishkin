{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "mti",
    "stan",
    "pan",
    "processingCode",
    "amount",
    "currencyCode",
    "terminalId",
    "merchantId",
    "mcc",
    "acquirerId",
    "status",
    "transmissionDateTime",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "mti": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "stan": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "rrn": {
      "type": ["string", "null"]
    },
    "pan": {
      "type": "string",
      "pattern": "^[0-9]{16}$"
    },
    "processingCode": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "amount": {
      "type": "number"
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "terminalId": {
      "type": "string",
      "minLength": 1
    },
    "merchantId": {
      "type": "string",
      "minLength": 1
    },
    "mcc": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "acquirerId": {
      "type": "string",
      "minLength": 1
    },
    "issuerId": {
      "type": ["string", "null"]
    },
    "acquiringFee": {
      "type": ["number", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "DECLINED"]
    },
    "declineReason": {
      "type": ["string", "null"]
    },
    "authCode": {
      "type": ["string", "null"]
    },
    "processingTimeMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "transmissionDateTime": {
      "type": "string",
      "minLength": 10
    },
    "createdAt": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": true
}
