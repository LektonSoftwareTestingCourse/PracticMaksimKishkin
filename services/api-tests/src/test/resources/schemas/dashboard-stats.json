{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "totalTransactions",
    "approvedCount",
    "declinedCount",
    "approvalRate",
    "totalAmount",
    "averageAmount",
    "avgProcessingTimeMs",
    "transactionsPerMinute"
  ],
  "properties": {
    "totalTransactions": {
      "type": "integer",
      "minimum": 0
    },
    "approvedCount": {
      "type": "integer",
      "minimum": 0
    },
    "declinedCount": {
      "type": "integer",
      "minimum": 0
    },
    "approvalRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "totalAmount": {
      "type": "number"
    },
    "averageAmount": {
      "type": "number"
    },
    "avgProcessingTimeMs": {
      "type": "number"
    },
    "transactionsPerMinute": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
