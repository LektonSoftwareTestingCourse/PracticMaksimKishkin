{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "pan",
    "bin",
    "cardholderName",
    "expiryDate",
    "status",
    "currencyCode",
    "dailyLimit",
    "monthlyLimit",
    "availableBalance",
    "issuerId",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "pan": {
      "type": "string",
      "pattern": "^[0-9]{16}$"
    },
    "bin": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "cardholderName": {
      "type": "string",
      "minLength": 1
    },
    "expiryDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "INACTIVE", "BLOCKED", "EXPIRED"]
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "dailyLimit": {
      "type": "number"
    },
    "monthlyLimit": {
      "type": "number"
    },
    "availableBalance": {
      "type": "number"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "createdAt": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": true
}
