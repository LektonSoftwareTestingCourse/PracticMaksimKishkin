{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "mti",
    "stan",
    "rrn",
    "authCode",
    "responseCode",
    "status",
    "declineReason",
    "processingTimeMs"
  ],
  "properties": {
    "mti": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}$"
    },
    "stan": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{6}$"
    },
    "rrn": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{12}$"
    },
    "authCode": {
      "type": ["string", "null"],
      "pattern": "^[A-Z0-9]{6}$"
    },
    "responseCode": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "DECLINED"]
    },
    "declineReason": {
      "type": ["string", "null"]
    },
    "processingTimeMs": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
